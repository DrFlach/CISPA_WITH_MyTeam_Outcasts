def load_parquet_files():
    task_files = sorted(glob.glob(str(TASK_DIR / "*.parquet")))
    validation_files = sorted(glob.glob(str(VALIDATION_DIR / "*.parquet")))

    if not task_files:
        raise FileNotFoundError("No parquet files found in task/")

    if not validation_files:
        raise FileNotFoundError("No parquet files found in validation_pii/")

    safe_print("Task parquet files:")
    for file in task_files:
        safe_print(f"  {file}")

    safe_print("Validation parquet files:")
    for file in validation_files:
        safe_print(f"  {file}")

    task_dfs = []
    for file in task_files:
        df = pd.read_parquet(file)
        df["_source_file"] = Path(file).name
        task_dfs.append(df)

    validation_dfs = []
    for file in validation_files:
        df = pd.read_parquet(file)
        df["_source_file"] = Path(file).name
        validation_dfs.append(df)

    task_df = pd.concat(task_dfs, ignore_index=True)
    validation_df = pd.concat(validation_dfs, ignore_index=True)

    return task_df, validation_df


