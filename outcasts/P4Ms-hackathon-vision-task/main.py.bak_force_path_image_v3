def normalize_col_name(col):
    return str(col).strip().lower().replace("-", "_").replace(" ", "_")


def pick_column(df, exact_candidates, contains_candidates):
    norm_map = {normalize_col_name(c): c for c in df.columns}

    for cand in exact_candidates:
        cand_norm = normalize_col_name(cand)
        if cand_norm in norm_map:
            return norm_map[cand_norm]

    for col in df.columns:
        n = normalize_col_name(col)
        for needle in contains_candidates:
            if needle in n:
                return col

    return None


def detect_columns(df):
    id_col = pick_column(
        df,
        ["id", "sample_id", "example_id", "idx", "index"],
        ["id"],
    )

    image_col = pick_column(
        df,
        ["image", "img", "picture", "pixel_values"],
        ["image", "img", "picture"],
    )

    question_col = pick_column(
        df,
        ["question", "query", "prompt", "instruction", "text"],
        ["question", "query", "prompt", "instruction"],
    )

    answer_col = pick_column(
        df,
        ["answer", "answers", "response", "target", "label", "completion"],
        ["answer", "response", "target", "label", "completion"],
    )

    pii_type_col = pick_column(
        df,
        ["pii_type", "type", "entity_type", "secret_type"],
        ["pii", "type"],
    )

    return {
        "id": id_col,
        "image": image_col,
        "question": question_col,
        "answer": answer_col,
        "pii_type": pii_type_col,
    }


def stringify_value(x):
    try:
        if pd.isna(x) and not isinstance(x, (list, dict, tuple, bytes, bytearray)):
            return ""
    except Exception:
        pass

    return str(x)


def infer_validation_stats(validation_df):
    stats = {
        "email_domains": Counter(),
        "credit_separators": Counter(),
        "credit_lengths_digits": Counter(),
        "phone_prefixes": Counter(),
        "phone_lengths_digits": Counter(),
        "examples": defaultdict(list),
        "fallback": {
            "EMAIL": "unknown@example.com",
            "CREDIT": "0000 0000 0000 0000",
            "PHONE": "+00 000 000 000",
        },
    }

    all_texts = []

    for _, row in validation_df.iterrows():
        parts = []

        for col in validation_df.columns:
            val = row[col]
            if isinstance(val, str):
                parts.append(val)

        all_texts.append(" ".join(parts))

    email_re = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
    credit_re = re.compile(r"(?<!\d)(?:\d[ -]?){13,19}(?!\d)")
    phone_re = re.compile(r"(?<![\w@])\+?\d[\d\s().-]{8,}\d(?![\w@])")

    for text in all_texts:
        for email in email_re.findall(text):
            domain = email.split("@")[-1].lower()
            stats["email_domains"][domain] += 1

            if len(stats["examples"]["EMAIL"]) < 10:
                stats["examples"]["EMAIL"].append(email)

        for credit in credit_re.findall(text):
            digits = re.sub(r"\D", "", credit)

            if 13 <= len(digits) <= 19:
                if " " in credit:
                    stats["credit_separators"]["space"] += 1
                elif "-" in credit:
                    stats["credit_separators"]["dash"] += 1
                else:
                    stats["credit_separators"]["none"] += 1

                stats["credit_lengths_digits"][len(digits)] += 1

                if len(stats["examples"]["CREDIT"]) < 10:
                    stats["examples"]["CREDIT"].append(credit.strip())

        for phone in phone_re.findall(text):
            digits = re.sub(r"\D", "", phone)

            if 9 <= len(digits) <= 15:
                prefix = phone.strip()[:4]
                stats["phone_prefixes"][prefix] += 1
                stats["phone_lengths_digits"][len(digits)] += 1

                if len(stats["examples"]["PHONE"]) < 10:
                    stats["examples"]["PHONE"].append(phone.strip())

    if stats["examples"]["EMAIL"]:
        stats["fallback"]["EMAIL"] = stats["examples"]["EMAIL"][0]
    elif stats["email_domains"]:
        domain = stats["email_domains"].most_common(1)[0][0]
        stats["fallback"]["EMAIL"] = f"unknown@{domain}"

    if stats["examples"]["CREDIT"]:
        stats["fallback"]["CREDIT"] = stats["examples"]["CREDIT"][0]

    if stats["examples"]["PHONE"]:
        stats["fallback"]["PHONE"] = stats["examples"]["PHONE"][0]

    
